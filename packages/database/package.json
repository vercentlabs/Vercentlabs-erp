{
  "name": "@vercentlabs/database",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/test-database.d.ts",
      "default": "./dist/test-database.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "migrate": "tsx src/migrate.ts"
  },
  "dependencies": {
    "pg": "8.13.1",
    "drizzle-orm": "0.38.3"
  },
  "devDependencies": {
    "@vercentlabs/typescript-config": "workspace:*",
    "@vercentlabs/eslint-config": "workspace:*",
    "drizzle-kit": "0.30.1",
    "typescript": "5.7.3",
    "tsx": "4.19.2",
    "vitest": "2.1.8",
    "@types/pg": "8.11.10"
  }
}
