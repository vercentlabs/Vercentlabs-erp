{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [
    ".claude/**",
    "database/**",
    "infrastructure/**",
    "patches/**",
    "**/.next/**",
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/storybook-static/**",
    "**/test-results/**",
    "**/playwright-report/**",
    "apps/mobile/.expo/**",
    "apps/mobile/android/**",
    "apps/mobile/ios/**",
    "packages/design-tokens/generated/**"
  ],
  "ignoreDependencies": ["dotenv", "pg"],
  "workspaces": {
    "apps/web": {
      "entry": [
        "src/app/**/{page,layout,route,loading,error,global-error,not-found,template,default,sitemap,robots,manifest}.{ts,tsx}",
        "src/proxy.ts",
        "src/instrumentation.ts",
        "scripts/**/*.mjs"
      ],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "apps/landing": {
      "entry": [
        "app/**/{page,layout,route,loading,error,global-error,not-found,template,default,sitemap,robots,manifest}.{ts,tsx}",
        "middleware.ts",
        "scripts/**/*.mjs"
      ],
      "project": ["app/**/*.{ts,tsx}", "components/**/*.{ts,tsx}", "lib/**/*.{ts,tsx}"]
    },
    "apps/mobile": {
      "entry": ["App.tsx", "index.ts", "app/**/*.tsx"],
      "project": ["**/*.{ts,tsx}"]
    },
    "services/api": {
      "entry": ["src/index.js"],
      "project": ["src/**/*.js"]
    },
    "services/worker": {
      "entry": ["src/index.js"],
      "project": ["src/**/*.js"]
    },
    "packages/*": {
      "entry": ["src/index.{js,ts}", "src/*.d.ts"],
      "project": ["src/**/*.{js,ts,tsx}"]
    }
  }
}
