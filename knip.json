{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [
    ".claude/**",
    "docs/**",
    "database/**",
    "infrastructure/**",
    "patches/**",
    "**/.next/**",
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/storybook-static/**",
    "**/test-results/**",
    "**/playwright-report/**",
    "apps/mobile/.expo/**",
    "apps/mobile/android/**",
    "apps/mobile/ios/**",
    "packages/design-tokens/generated/**"
  ],
  "ignoreDependencies": ["dotenv", "pg"],
  "workspaces": {
    ".": {
      "entry": ["scripts/**/*.mjs"],
      "project": ["scripts/**/*.mjs"]
    },
    "apps/web": {
      "entry": [
        "src/app/**/{page,layout,route,loading,error,global-error,not-found,template,default,sitemap,robots,manifest}.{ts,tsx}",
        "src/middleware.ts",
        "e2e/**/*.{spec,setup}.ts",
        "e2e/*.ts",
        "scripts/**/*.mjs"
      ],
      "project": ["src/**/*.{ts,tsx}", "e2e/**/*.ts"]
    },
    "apps/landing": {
      "entry": [
        "app/**/{page,layout,route,loading,error,global-error,not-found,template,default,sitemap,robots,manifest}.{ts,tsx}",
        "middleware.ts",
        "tests/**/*.{spec,setup,test}.{ts,tsx}",
        "scripts/**/*.mjs"
      ],
      "project": ["app/**/*.{ts,tsx}", "components/**/*.{ts,tsx}", "lib/**/*.{ts,tsx}"]
    },
    "apps/mobile": {
      "entry": ["App.tsx", "index.ts", "app/**/*.tsx", "e2e/**/*.ts"],
      "project": ["**/*.{ts,tsx}"]
    },
    "services/api": {
      "entry": ["src/index.js", "tests/**/*.test.mjs"],
      "project": ["src/**/*.js"]
    },
    "services/worker": {
      "entry": ["src/index.js", "tests/**/*.test.mjs", "src/**/*.test.mjs"],
      "project": ["src/**/*.js"]
    },
    "packages/*": {
      "entry": ["src/index.{js,ts}", "src/**/*.test.{js,mjs,ts}", "src/*.d.ts"],
      "project": ["src/**/*.{js,ts,tsx}"]
    },
    "tests": {
      "entry": ["integration/**/*.test.mjs", "security/**/*.test.mjs"],
      "project": ["**/*.mjs"]
    }
  }
}
