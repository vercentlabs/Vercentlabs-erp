*.swp
*.swo

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini

# Temporary files
tmp/
temp/
.cache/

# Secrets and certificates
*.pem
*.key
*.crt

# Expo machine-specific state
apps/mobile/.expo/
apps/mobile/android/
apps/mobile/ios/

# Local-only marketing demo org credentials (never commit)
apps/landing/scripts/.demo-org-credentials.local.md
apps/landing/scripts/.captured-screenshots.local.json
apps/landing/scripts/.demo-org-record-ids.local.json
vercentlabs-full-code.txt
*-full-code.txt

# Generated source-export snapshots (scripts/export/export-source.mjs) —
# reproducible artifacts, never the source of truth, never committed.
/exports/
vercentlabs-all-code-*.txt
vercentlabs-all-code-*.txt.gz
vercentlabs-all-code-*.manifest.json
# Python generated cache
__pycache__/
*.py[cod]

# CRM rebuild tooling scratch state (backups/patches/logs) — never source of truth
/.crm-rebuild/
/.crm-uiux/

# Storybook build output — reproducible artifact, never source of truth.
storybook-static/

# Prompt 3 live-browser visual QA artifacts (screenshots, inventory,
# storage-state.json session cookies) — reproducible by re-running
# apps/web/scripts/qa/*.mjs against a real environment, never committed.
# The .mjs scripts themselves ARE committed (real QA tooling).
scripts/qa/artifacts/
apps/web/scripts/qa/artifacts/

.next-build/

# Terraform: never commit state, plans or provider caches
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
tfplan*
crash.log
*.tfvars
!*.tfvars.example
