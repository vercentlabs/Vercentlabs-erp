# Public production URL, used for canonical links, sitemap, robots, and OG/JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.vercentlabs.com

# apps/web's public URL — the header/footer "Sign in" link and the server-side
# lead-delivery proxy (lib/crm-capture.ts) both target this origin.
NEXT_PUBLIC_APP_URL=https://app.vercentlabs.com

# Shared secret for signing demo-request submissions that are proxied
# server-side to apps/web/src/app/api/crm/public/capture/[key]/route.ts. Must
# match the same value configured in apps/web (see apps/web/.env.example).
# Server-only — never exposed to the browser.
CRM_CAPTURE_PROXY_SECRET=

# The public form key (UUID-shaped) identifying which organization's CRM
# receives demo-request leads — see apps/web's tenant.crm_capture_forms table.
# Server-only. In this phase's local/dev environment this points at a form
# created on a dedicated synthetic "Vercent Demo Manufacturing" organization
# (see docs/landing-redesign/phase-3/conversion-form-specification.md) — a
# real production deployment must point this at whatever organization the
# Vercentlabs sales team actually designates to receive marketing leads.
CRM_CAPTURE_FORM_KEY=

# Set only when requests always pass through a trusted reverse proxy that
# overwrites this header itself (never a client-suppliable one) — e.g.
# "x-forwarded-for" or "cf-connecting-ip". Same env var name/semantics as
# apps/web's own security.ts. If unset, lib/request.ts's clientIp() never
# trusts any client-supplied header (a real Phase 8 security fix — the
# previous default blindly trusted X-Forwarded-For, letting a client bypass
# /api/book-demo's rate limit entirely with a spoofed header on every
# request). Every request rate-limits into one shared bucket until this is
# configured for the real production deployment topology.
TRUSTED_PROXY_IP_HEADER=
# Which comma-separated entry (0-indexed from the left) in the configured
# header to trust as the real client IP — depends on how many proxies sit in
# front of the app. Defaults to 0 if unset.
TRUSTED_PROXY_CLIENT_INDEX=
