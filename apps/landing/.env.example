# Canonical public website URL. Use the final HTTPS production domain.
NEXT_PUBLIC_SITE_URL=https://vercentlabs.com

# Deployed authenticated ERP application. Leave empty until secure account
# registration is available; public pricing will then request early access.
NEXT_PUBLIC_ERP_APP_URL=

# Optional content date used by sitemap entries (ISO date or timestamp).
NEXT_PUBLIC_CONTENT_UPDATED_AT=2026-07-25

# Public business contact address.
NEXT_PUBLIC_CONTACT_EMAIL=vercentlabs@gmail.com

# Comma-separated browser origins allowed to submit forms.
# Production should include only the public HTTPS website origin.
FORM_ALLOWED_ORIGINS=https://vercentlabs.com

# Distributed form rate limiting for production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Contact webhook. Secrets stay server-side.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=

# Optional separate destination for focused demo requests.
# When omitted, demo requests use the main CRM capture or lead webhook.
DEMO_WEBHOOK_URL=
DEMO_WEBHOOK_SECRET=

# Legacy aliases retained temporarily for older deployments.
SIGNUP_WEBHOOK_URL=
SIGNUP_WEBHOOK_SECRET=

# Maximum webhook request time in milliseconds.
WEBHOOK_TIMEOUT_MS=8000

# Trusted reverse-proxy client-IP header. Configure this explicitly in production.
TRUSTED_PROXY_IP_HEADER=
TRUSTED_PROXY_CLIENT_INDEX=0

# Preferred direct delivery into a CRM public capture form.
# The URL includes the public capture key.
CRM_CAPTURE_URL=
DEMO_CRM_CAPTURE_URL=

# Legacy alias retained temporarily for older deployments.
SIGNUP_CRM_CAPTURE_URL=

# Shared by landing and web; use at least 32 random characters.
CRM_CAPTURE_PROXY_SECRET=
