# Public production URL, used for canonical links, sitemap, robots, and OG/JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.vercentlabs.com

# apps/web's public URL — the header/footer "Sign in" link points here.
NEXT_PUBLIC_APP_URL=https://app.vercentlabs.com

# Reserved for Prompt 3's lead-capture form. Must match the same value configured
# in apps/web (see apps/web/.env.example) — it signs demo-request submissions that
# are proxied server-side to apps/web/src/app/api/crm/public/capture/[key]/route.ts.
# Not read by any code in Phase 2.
CRM_CAPTURE_PROXY_SECRET=
