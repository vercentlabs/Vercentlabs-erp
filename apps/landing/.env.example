# Canonical public website URL. Use the final HTTPS production domain.
NEXT_PUBLIC_SITE_URL=https://vercentlabs.com

# Deployed authenticated ERP application. Leave empty until available.
NEXT_PUBLIC_ERP_APP_URL=

# Public business contact address.
NEXT_PUBLIC_CONTACT_EMAIL=vercentlabs@gmail.com

# Comma-separated browser origins allowed to submit forms.
# Production should include only the public HTTPS website origin.
FORM_ALLOWED_ORIGINS=https://vercentlabs.com

# Distributed form rate limiting for production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Contact/design-partner webhook. Secrets stay server-side.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=

# Optional separate destination for design-partner applications.
SIGNUP_WEBHOOK_URL=
SIGNUP_WEBHOOK_SECRET=

# Maximum webhook request time in milliseconds.
WEBHOOK_TIMEOUT_MS=8000
