{
  "name": "@vercent/landing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/prepare-hostinger-output.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"next.config.mjs\" \"tsconfig.json\" \"README.md\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"next.config.mjs\" \"tsconfig.json\" \"README.md\"",
    "validate": "pnpm lint && pnpm typecheck && pnpm build",
    "test": "node --test"
  },
  "dependencies": {
    "@vercent/shared-types": "workspace:*",
    "lucide-react": "^1.24.0",
    "next": "16.2.11",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.18",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "prettier": "^3",
    "tailwindcss": "4.1.18",
    "typescript": "^5"
  }
}
