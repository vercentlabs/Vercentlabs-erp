{
  "name": "@vercentlabs/landing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build && node scripts/prepare-standalone.mjs",
    "start": "next start -p 3000",
    "prepare:standalone": "node scripts/prepare-standalone.mjs",
    "start:standalone": "node scripts/prepare-standalone.mjs && node .next/standalone/apps/landing/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test",
    "test:e2e": "playwright test",
    "test:browser": "playwright test",
    "test:e2e:install": "playwright install chromium --with-deps"
  },
  "dependencies": {
    "@vercentlabs/landing-content": "workspace:*",
    "@vercentlabs/shared-types": "workspace:*",
    "next": "16.2.11",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "postcss": "^8.5.23",
    "prettier": "^3.7.4",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3"
  }
}
