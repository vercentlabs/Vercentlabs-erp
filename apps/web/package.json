    "@tanstack/react-table": "9.2.4",
    "@tanstack/react-virtual": "3.14.12",
    "@vercentlabs/api": "workspace:*",
    "@vercentlabs/database": "workspace:*",
    "@vercentlabs/design-system": "workspace:*",
    "@vercentlabs/design-tokens": "workspace:*",
    "@vercentlabs/permissions": "workspace:*",
    "@vercentlabs/shared-types": "workspace:*",
    "class-variance-authority": "0.7.1",
    "lucide-react": "1.45.0",
    "next": "16.2.11",
    "react": "19.2.3",
    "react-aria-components": "1.21.1",
    "react-dom": "19.2.3",
    "tailwind-merge": "3.7.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "postcss": "^8.5.23",
    "prettier": "^3.7.4",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3"
  }
