{
  "name": "@vercent/web",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test",
    "verify:foundation": "node scripts/verify-foundation.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "db:cleanup-auth": "node scripts/cleanup-auth.mjs",
    "verify:database": "node scripts/verify-database.mjs",
    "email:verify": "node scripts/verify-email-delivery.mjs",
    "verify:experience": "node --test tests/design-system.test.mjs",
    "db:migrate:tenant": "node scripts/migrate-tenant.mjs",
    "verify:tenant-database": "node scripts/verify-tenant-database.mjs",
    "verify:business-data": "node scripts/verify-business-data.mjs",
    "verify:crm": "node scripts/verify-crm.mjs",
    "verify:crm-database": "node scripts/verify-crm-database.mjs",
    "crm:jobs": "node scripts/process-crm-jobs.mjs",
    "verify:billing": "node scripts/verify-billing.mjs",
