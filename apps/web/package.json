{
  "name": "@vercentlabs/web",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test",
    "verify:routes": "node scripts/verify-routes.mjs",
    "e2e:bootstrap": "tsx scripts/e2e-fixture-bootstrap.mts",
    "e2e:bootstrap:procurement": "tsx scripts/e2e-fixture-bootstrap.mts && tsx scripts/e2e-fixture-procurement.mts",
    "test:e2e:erp": "tsx scripts/e2e-fixture-bootstrap.mts && playwright test -c playwright.erp.config.ts",
    "test:e2e:erp:update": "tsx scripts/e2e-fixture-bootstrap.mts && playwright test -c playwright.erp.config.ts --update-snapshots",
    "test:e2e:crm": "tsx scripts/e2e-fixture-bootstrap.mts && playwright test -c playwright.erp.config.ts tests/e2e/erp-crm-navigation.spec.ts tests/e2e/erp-crm-opportunity-journey.spec.ts tests/e2e/erp-crm-lead-lifecycle-scoring.spec.ts tests/e2e/erp-crm-merge-hierarchy.spec.ts tests/e2e/erp-crm-sensitive-projection.spec.ts tests/e2e/erp-crm-opportunity-projection-parity.spec.ts",
    "test:e2e:procurement": "tsx scripts/e2e-fixture-bootstrap.mts && tsx scripts/e2e-fixture-procurement.mts && playwright test -c playwright.erp.config.ts tests/e2e/erp-procurement-source-to-pay-journey.spec.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:storybook": "node scripts/run-storybook-tests.mjs"
  },
  "dependencies": {
    "@vercentlabs/api": "workspace:*",
    "@vercentlabs/config": "workspace:*",
    "@vercentlabs/database": "workspace:*",
    "@vercentlabs/document-engine": "workspace:*",
    "@vercentlabs/localization": "workspace:*",
    "@vercentlabs/observability": "workspace:*",
    "@vercentlabs/permissions": "workspace:*",
    "@vercentlabs/reporting-engine": "workspace:*",
    "@vercentlabs/shared-types": "workspace:*",
    "@vercentlabs/shared-ui": "workspace:*",
    "@vercentlabs/ui-web": "workspace:*",
    "@vercentlabs/workflows": "workspace:*",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-table": "^9.2.4",
    "@tanstack/react-virtual": "^3.14.12",
    "dotenv": "^17.2.3",
    "next": "16.2.11",
    "nodemailer": "^9.0.3",
    "pg": "^8.16.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^3.10.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.15.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@tailwindcss/postcss": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "1.61.1",
    "tsx": "^4.23.13",
    "storybook": "^10.6.0",
    "@storybook/nextjs": "^10.6.0",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/test-runner": "^0.24.5"
  }
}
