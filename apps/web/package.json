{
  "name": "@vercentlabs/web",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test",
    "verify:routes": "node scripts/verify-routes.mjs",
    "e2e:bootstrap": "tsx scripts/e2e-fixture-bootstrap.mts",
    "test:e2e:erp": "tsx scripts/e2e-fixture-bootstrap.mts && playwright test -c playwright.erp.config.ts",
    "test:e2e:erp:update": "tsx scripts/e2e-fixture-bootstrap.mts && playwright test -c playwright.erp.config.ts --update-snapshots",
    "test:e2e:crm": "tsx scripts/e2e-fixture-bootstrap.mts && playwright test -c playwright.erp.config.ts tests/e2e/erp-crm-navigation.spec.ts tests/e2e/erp-crm-opportunity-journey.spec.ts tests/e2e/erp-crm-lead-lifecycle-scoring.spec.ts tests/e2e/erp-crm-merge-hierarchy.spec.ts tests/e2e/erp-crm-sensitive-projection.spec.ts tests/e2e/erp-crm-opportunity-projection-parity.spec.ts"
  },
  "dependencies": {
    "@vercentlabs/api": "workspace:*",
    "@vercentlabs/config": "workspace:*",
    "@vercentlabs/database": "workspace:*",
    "@vercentlabs/document-engine": "workspace:*",
    "@vercentlabs/localization": "workspace:*",
    "@vercentlabs/observability": "workspace:*",
    "@vercentlabs/permissions": "workspace:*",
    "@vercentlabs/reporting-engine": "workspace:*",
    "@vercentlabs/shared-types": "workspace:*",
    "@vercentlabs/shared-ui": "workspace:*",
    "@vercentlabs/workflows": "workspace:*",
    "dotenv": "^17.2.3",
    "next": "16.2.11",
    "nodemailer": "^9.0.3",
    "pg": "^8.16.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.15.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "1.61.1",
    "tsx": "^4.23.13"
  }
}
