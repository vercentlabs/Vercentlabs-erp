# apps/web environment reference. Copy to .env.local for local development
# (never commit .env.local — it's gitignored) and set the real equivalents
# through your hosting platform's secret manager for every other
# environment. Every value below is either a safe non-secret default or
# left blank — never a real credential.
#
# Startup validation: this app does NOT currently fail fast at boot if a
# required secret below is missing — each subsystem instead throws a real,
# typed error (503/500) the first time a request actually needs it (e.g.
# oauth.js's encryptionKey() throws PLATFORM_TOKEN_ENCRYPTION_NOT_CONFIGURED
# if INTEGRATION_TOKEN_ENCRYPTION_KEY is unset, auth-mailer.js's
# getSmtpConfiguration() throws if SMTP_* is partially configured). This is
# a real, disclosed gap: there is no single startup-time audit of this file
# against the running environment. Treat every REQUIRED variable below as
# something that must be verified present before a real production
# deployment goes live, not something the app will refuse to start without.

NODE_ENV=development

# ---------------------------------------------------------------------
# Core URLs
# ---------------------------------------------------------------------
# This app's own public URL — used to build absolute links in transactional
# email (verify-email/reset-password/invitation) and CORS/same-origin checks.
APP_URL=http://localhost:3001
# Comma-separated list of origins allowed to submit same-origin-checked
# form/API requests from a browser (assertSameOrigin/assertSameOriginOrMobile,
# services/api/src/core/security.js). Include every real origin that serves
# this app (and apps/landing, if it proxies requests here) in production.
FORM_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ---------------------------------------------------------------------
# Database (packages/database) — REQUIRED
# ---------------------------------------------------------------------
# Runtime connection — the restricted application role, never the
# migration/owner role. ENFORCE_RESTRICTED_DB_ROLE=true in production
# refuses to start against a connection string using an unrestricted role.
DATABASE_URL=postgresql://vercent_app:CHANGE_ME@localhost:5433/vercentlabs_control
ENFORCE_RESTRICTED_DB_ROLE=false
DATABASE_SSL=false
DATABASE_POOL_MAX=12
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_QUERY_TIMEOUT_MS=20000
# Migration/owner role — only needed for `pnpm db:migrate`/`db:setup` and
# for real-Postgres integration tests (tests/integration/*.test.mjs), never
# read by the running application itself. Keep this out of any environment
# that only serves traffic.
MIGRATION_DATABASE_URL=postgresql://vercentlabs:CHANGE_ME@localhost:5433/vercentlabs_control

# ---------------------------------------------------------------------
# Sessions (services/api/src/core/session.js) — REQUIRED
# ---------------------------------------------------------------------
SESSION_COOKIE_NAME=vercent_session
SESSION_IDLE_MINUTES=480
SESSION_ABSOLUTE_DAYS=30
MOBILE_ACCESS_TOKEN_MINUTES=30
MOBILE_REFRESH_TOKEN_DAYS=30
MOBILE_SESSION_IDLE_DAYS=14

# ---------------------------------------------------------------------
# Encryption — REQUIRED for OAuth connections (services/api/src/core/
# oauth.js) and MFA (services/api/src/core/mfa.js), which share this one
# key. AES-256-GCM, so this MUST be exactly 32 bytes: either 64 hex
# characters or a base64 string that decodes to 32 bytes.
#
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Rotation: there is no built-in key-rotation/re-encryption path today —
# rotating this key makes every already-stored OAuth token and MFA secret
# permanently undecryptable (every user would need to reconnect their
# integrations and re-enroll MFA). Treat this as a long-lived secret backed
# up in your platform's secret manager, not something rotated casually.
# ---------------------------------------------------------------------
INTEGRATION_TOKEN_ENCRYPTION_KEY=

# ---------------------------------------------------------------------
# Transactional email (services/api/src/core/auth-mailer.js)
# ---------------------------------------------------------------------
# All four SMTP_* below must be set together, or all left blank — a
# partially-filled set is treated as a real misconfiguration and every
# verify-email/reset-password/invitation call fails with a 500 (deliberate
# fail-loud behavior, not a bug).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
AUTH_EMAIL_FROM=
AUTH_EMAIL_REPLY_TO=support@vercentlabs.com
AUTH_EMAIL_TIMEOUT_MS=10000
# Local/test-only: routes auth-mailer's webhook path to this app's own
# test-support capture endpoint instead of real SMTP, so E2E tests can
# retrieve the exact verify-email/reset-password/invitation URL. The
# capture route independently refuses to run outside NODE_ENV=development
# or test — never enable these in a real deployment.
AUTH_EMAIL_WEBHOOK_URL=
AUTH_EMAIL_CAPTURE_ENABLED=
AUTH_EMAIL_WEBHOOK_SECRET=

# ---------------------------------------------------------------------
# SaaS billing / Razorpay (services/api/src/core/billing/, docs/01-standards/SAAS_BILLING_ARCHITECTURE.md)
# Used by BOTH apps/web (checkout, webhook ingestion) and services/worker (webhook
# processing, retries, recovery, reconciliation). Secrets never reach the browser.
# ---------------------------------------------------------------------
RAZORPAY_MODE=test
# rzp_test_... in test mode, rzp_live_... in live mode (checked at startup).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Keep the old secret here while rotating; both are accepted.
RAZORPAY_WEBHOOK_SECRET_PREVIOUS=
RAZORPAY_REQUEST_TIMEOUT_MS=10000
# Set to true only with Razorpay keys and a webhook secret. Point the Razorpay dashboard webhook at
# {APP_URL}/api/billing/webhook with events subscription.authenticated, .activated, .charged, .pending,
# .halted, .cancelled, .completed, .updated, payment.captured, payment.failed, invoice.paid and refund.processed.
BILLING_CHECKOUT_ENABLED=false
# Test stand-in only (ignored when RAZORPAY_MODE=live). Leave blank to use Razorpay.
RAZORPAY_API_BASE=
# Where the Custom plan's "Contact us" link goes (https:// or mailto:). Blank shows a support hint.
BILLING_SALES_CONTACT_URL=
# Worker: platform billing maintenance (replaces the retired /api/billing/retry endpoint).
BILLING_MAINTENANCE_ENABLED=true
BILLING_MAINTENANCE_INTERVAL_MS=15000
BILLING_MAINTENANCE_BATCH_SIZE=20
# "observe" logs what WOULD be blocked without blocking; "enforce" blocks business
# writes for an inactive subscription (requireBillingWriteAccess). Defaults to
# enforce only when NODE_ENV=production; set it explicitly.
BILLING_ENFORCEMENT_MODE=observe
# Vercentlabs GST tax invoices are NOT generated yet. Every one of these legal facts
# must be configured before that can ever be enabled; until then Billing shows the
# payment provider's invoices/receipts only.
BILLING_SUPPLIER_LEGAL_NAME=
BILLING_SUPPLIER_GSTIN=
BILLING_SUPPLIER_STATE_CODE=
BILLING_SUPPLIER_ADDRESS=
BILLING_SERVICE_SAC=
BILLING_GST_RATE_PERCENT=
BILLING_TAX_INVOICE_SERIES=

# ---------------------------------------------------------------------
# CRM inbound integrations (webhook/proxy shared secrets)
# ---------------------------------------------------------------------
CRM_CAPTURE_PROXY_SECRET=
CRM_INBOUND_EMAIL_SECRET=
CRM_PROVIDER_WEBHOOK_SECRET=
CRM_ACQUISITION_WEBHOOK_SECRET=

# ---------------------------------------------------------------------
# Shared Platform services
# ---------------------------------------------------------------------
# Inbound email (Settings > Integrations > Inbound email) uses a per-route
# signing secret created in the UI; there is no global inbound secret.
#
# File/object storage. Development defaults to "local" under the OS temp
# directory. Production has no default: a cloud storage provider is required
# (local and memory drivers are refused when NODE_ENV=production).
FILE_STORAGE_DRIVER=
FILE_STORAGE_LOCAL_ROOT=
#
# OAuth connected accounts (Authorization Code + PKCE). Register
# APP_URL/api/settings/integrations/oauth/callback/<google|microsoft> as the
# redirect URI with each provider. Leave unset to show the profile as
# "Not set up".
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
# Tests only: point both providers at tests/support/oauth-standin.mjs.
# Refused when NODE_ENV=production.
OAUTH_STANDIN_URL=

# ---------------------------------------------------------------------
# POS payment provider (services/api/src/modules/point-of-sale/
# tender-and-payment-execution) — sandbox adapter only today, see
# POS_FINAL_FUNCTIONAL_VERIFICATION.md for the disclosed live-provider gap.
# ---------------------------------------------------------------------
POS_SANDBOX_PAYMENT_WEBHOOK_SECRET=

# ---------------------------------------------------------------------
# Attachments (services/api/src/core/attachment-security.js) — optional
# malware-scan integration; ATTACHMENT_SCAN_MODE controls whether uploads
# are blocked pending a scan result.
# ---------------------------------------------------------------------
ATTACHMENT_SCAN_MODE=disabled
ATTACHMENT_SCAN_URL=
ATTACHMENT_SCAN_TOKEN=

# ---------------------------------------------------------------------
# Reverse proxy trust (services/api/src/core/security.js) — leave unset
# unless requests always pass through a trusted proxy that overwrites this
# header itself. If unset, client-IP-based rate limiting never trusts any
# client-suppliable header.
# ---------------------------------------------------------------------
TRUSTED_PROXY_IP_HEADER=
TRUSTED_PROXY_CLIENT_INDEX=

# ---------------------------------------------------------------------
# Background worker (services/worker) — read by the worker process, not
# this Next.js app, but shares the same DATABASE_URL/MIGRATION_DATABASE_URL
# above when run against the same environment.
# ---------------------------------------------------------------------
WORKER_ENABLED=true
WORKER_CONCURRENCY=4
WORKER_POLL_INTERVAL_MS=5000
WORKER_LEASE_MS=120000
WORKER_BATCH_SIZE=10
WORKER_SCHEDULER_TICK_MS=300000
WORKER_WEBHOOK_TIMEOUT_MS=10000
WORKER_ALLOW_PRIVATE_WEBHOOK_TARGETS=false

# ---------------------------------------------------------------------
# E2E / QA only — never set in a real deployment. See apps/web/e2e/fixtures.ts
# and playwright.erp.config.ts for how these are consumed.
# ---------------------------------------------------------------------
ERP_E2E_EMAIL=
ERP_E2E_PASSWORD=
ERP_E2E_RESTRICTED_EMAIL=
ERP_E2E_RESTRICTED_PASSWORD=
