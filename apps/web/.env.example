# Local development example. Never commit real credentials.
NODE_ENV=development
APP_URL=http://localhost:3001
FORM_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Runtime role — intentionally different from the migration/owner role.
DATABASE_URL=postgresql://vercent_app:change-this-runtime-password-please@localhost:5433/vercentlabs_control
MIGRATION_DATABASE_URL=postgresql://vercentlabs:vercentlabs_local_password@localhost:5433/vercentlabs_control
ENFORCE_RESTRICTED_DB_ROLE=false

DATABASE_POOL_MAX=12
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_QUERY_TIMEOUT_MS=20000

SESSION_COOKIE_NAME=vercent_session
SESSION_IDLE_MINUTES=480
SESSION_ABSOLUTE_DAYS=30
MOBILE_ACCESS_TOKEN_MINUTES=30
MOBILE_REFRESH_TOKEN_DAYS=30
MOBILE_SESSION_IDLE_DAYS=14

AUTH_EMAIL_FROM="Vercentlabs Security <auth@vercentlabs.com>"
AUTH_EMAIL_REPLY_TO=support@vercentlabs.com
AUTH_EMAIL_WEBHOOK_URL=
AUTH_EMAIL_WEBHOOK_SECRET=
AUTH_EMAIL_TIMEOUT_MS=10000
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=auth@vercentlabs.com
SMTP_PASSWORD=

RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_WEBHOOK_SECRET_PREVIOUS=
RAZORPAY_REQUEST_TIMEOUT_MS=10000
BILLING_CHECKOUT_ENABLED=false
BILLING_ENFORCEMENT_MODE=observe

CRM_CAPTURE_PROXY_SECRET=
CRM_INBOUND_EMAIL_SECRET=
CRM_PROVIDER_WEBHOOK_SECRET=
CRM_ACQUISITION_WEBHOOK_SECRET=

WORKER_ENABLED=true
WORKER_CONCURRENCY=4
WORKER_POLL_INTERVAL_MS=5000
WORKER_LEASE_MS=120000
WORKER_BATCH_SIZE=10
WORKER_SCHEDULER_TICK_MS=300000
WORKER_WEBHOOK_TIMEOUT_MS=10000
WORKER_ALLOW_PRIVATE_WEBHOOK_TARGETS=false

# Authenticated ERP browser gate (pnpm test:e2e:erp / test:e2e:crm — see
# playwright.erp.config.ts). Point these at a dedicated, non-production
# fixture user with real, verified access to the referenced records — the
# local dev DB's "QA Test Org" (organization_owner: qa.tester@vercentlabs.test)
# is the established convention; see
# docs/03-modules/crm/CRM_VNEXT_IMPLEMENTATION_REGISTER.md Prompt 2 evidence
# log for how its fixtures were set up. Never commit real values here.
ERP_E2E_EMAIL=
ERP_E2E_PASSWORD=
ERP_E2E_LEAD_ID=
ERP_E2E_OPPORTUNITY_ID=
ERP_E2E_QUOTATION_ID=
ERP_E2E_SALES_ORDER_ID=
# CRM vNext Prompt 3 continuation: sensitive-field projection E2E gate.
# ERP_E2E_RESTRICTED_EMAIL/PASSWORD must belong to a fixture user with
# crm.view but WITHOUT crm.accounts.view_sensitive/crm.contacts.view_sensitive
# (e.g. the "read_only" role) — deliberately distinct from ERP_E2E_EMAIL,
# which is expected to be an org owner/admin with full sensitive access.
# (Prompts 1-5 integrity closeout: erp-crm-sensitive-projection.spec.ts and
# erp-crm-merge-hierarchy.spec.ts used to also require a manually-seeded
# ERP_E2E_SENSITIVE_ACCOUNT_ID/ERP_E2E_SENSITIVE_CONTACT_ID/
# ERP_E2E_SENTINEL_GSTIN/ERP_E2E_SENTINEL_CONTACT_EMAIL fixture — both now
# self-seed that Account/Contact fixture at run time via the app's own
# create endpoints, so those vars are no longer part of this gate.)
ERP_E2E_RESTRICTED_EMAIL=
ERP_E2E_RESTRICTED_PASSWORD=
