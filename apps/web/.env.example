APP_URL=http://localhost:3001
# Runtime URL must use a restricted NOSUPERUSER/NOBYPASSRLS role.
DATABASE_URL=postgresql://vercent_app:replace_with_runtime_password@localhost:5433/vercent_control
DATABASE_POOL_MAX=12
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_QUERY_TIMEOUT_MS=20000
# Migration URL must use the schema-owner/migration role and is never used by the web runtime.
MIGRATION_DATABASE_URL=postgresql://vercent:vercent_local_password@localhost:5433/vercent_control
APP_DATABASE_ROLE=vercent_app
APP_DATABASE_PASSWORD=replace_with_at_least_24_random_characters
# Production must fail closed unless the runtime role is restricted and RLS-enforced.
ENFORCE_RESTRICTED_DB_ROLE=true
SESSION_COOKIE_NAME=vercent_session
SESSION_ABSOLUTE_DAYS=30
SESSION_IDLE_MINUTES=480
FORM_ALLOWED_ORIGINS=http://localhost:3001
# Set only when requests always pass through a trusted proxy that overwrites this header.
# Examples: x-forwarded-for, cf-connecting-ip, x-vercel-forwarded-for.
TRUSTED_PROXY_IP_HEADER=
TRUSTED_PROXY_CLIENT_INDEX=0

# Authentication email delivery. Keep real credentials only in ignored .env.local.
AUTH_EMAIL_WEBHOOK_URL=
AUTH_EMAIL_WEBHOOK_SECRET=
AUTH_EMAIL_TIMEOUT_MS=8000

# SMTP fallback for authentication and invitation email delivery.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
AUTH_EMAIL_FROM=
# Optional recipient used only by the email verification command.
TEST_EMAIL=

# Razorpay Subscriptions. Begin with Test Mode credentials.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_WEBHOOK_SECRET_PREVIOUS=
RAZORPAY_MODE=test
RAZORPAY_WEBHOOK_MAX_BYTES=262144
RAZORPAY_WEBHOOK_MAX_AGE_SECONDS=86400

# Production checkout stays disabled until test-mode webhooks, tax documents and support are ready.
BILLING_CHECKOUT_ENABLED=false

# Keep observe mode until public HTTPS webhooks and recovery flows are tested.
BILLING_ENFORCEMENT_MODE=observe

# Conservative configurable reserve, not a statement of Razorpay's actual fee.
BILLING_PAYMENT_COST_RESERVE_PERCENT=4
BILLING_MIN_GROSS_MARGIN_PERCENT=70

# CRM outbox worker. In non-production tests, use CRM_OUTBOX_PROVIDER=fake.
CRM_OUTBOX_PROVIDER=
CRM_OUTBOX_BATCH_SIZE=25
CRM_OUTBOX_MAX_ATTEMPTS=5
CRM_OUTBOX_LEASE_SECONDS=300
CRM_OUTBOUND_REQUIRE_EXPLICIT_CONSENT=true
CRM_EMAIL_WEBHOOK_URL=
CRM_EMAIL_WEBHOOK_SECRET=
CRM_EMAIL_TIMEOUT_MS=10000
CRM_EMAIL_FROM=
CRM_SMTP_HOST=
CRM_SMTP_PORT=465
CRM_SMTP_SECURE=true
CRM_SMTP_USER=
CRM_SMTP_PASSWORD=

# Shared secret for trusted landing-to-CRM capture delivery.
# Use the same value in apps/landing; minimum 32 random characters.
CRM_CAPTURE_PROXY_SECRET=

# Production worker polling. One-shot scripts are supervised by the deployment platform.
CRM_JOBS_INTERVAL_SECONDS=60
CRM_OUTBOX_INTERVAL_SECONDS=30
BILLING_RECONCILE_INTERVAL_SECONDS=3600
