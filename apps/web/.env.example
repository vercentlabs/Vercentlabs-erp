# Next.js only loads .env files from this directory, not the repo root -
# copy this to apps/web/.env for local development. NEXT_PUBLIC_* values are
# inlined into the client bundle at build time, so they must be set before
# running `next build`, not just before `next start`.

WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1
