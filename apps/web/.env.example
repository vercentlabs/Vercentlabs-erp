APP_URL=http://localhost:3001
DATABASE_URL=postgresql://vercent:vercent_local_password@localhost:5433/vercent_control
SESSION_COOKIE_NAME=vercent_session
SESSION_ABSOLUTE_DAYS=30
SESSION_IDLE_MINUTES=480
FORM_ALLOWED_ORIGINS=http://localhost:3001

# Authentication email delivery. Keep real credentials only in ignored .env.local.
AUTH_EMAIL_WEBHOOK_URL=
AUTH_EMAIL_WEBHOOK_SECRET=
AUTH_EMAIL_TIMEOUT_MS=8000

# SMTP fallback for authentication and invitation email delivery.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
AUTH_EMAIL_FROM=
# Optional recipient used only by the email verification command.
TEST_EMAIL=

# Razorpay Subscriptions. Begin with Test Mode credentials.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_WEBHOOK_SECRET_PREVIOUS=
RAZORPAY_MODE=test

# Production checkout stays disabled until test-mode webhooks, tax documents and support are ready.
BILLING_CHECKOUT_ENABLED=false

# Keep observe mode until public HTTPS webhooks and recovery flows are tested.
BILLING_ENFORCEMENT_MODE=observe

# Conservative configurable reserve, not a statement of Razorpay's actual fee.
BILLING_PAYMENT_COST_RESERVE_PERCENT=4
BILLING_MIN_GROSS_MARGIN_PERCENT=70
