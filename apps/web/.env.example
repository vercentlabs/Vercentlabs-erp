# Vercentlabs ERP — local development environment (web + worker).
# Copy to the repository root as .env (or apps/web/.env.local) and fill in the
# blanks. Never commit a real .env. Every value here is a safe local default
# or blank — never a real credential.
#
# Other environments:
#   CI          infrastructure/env/ci.env.example
#   staging     infrastructure/env/staging.env.example   (rendered by Kubernetes)
#   production  infrastructure/env/production.env.example
#
# Startup validation (packages/config validateRuntimeEnvironment) runs when the
# web and worker start and lists every problem at once; production refuses to
# start with an invalid configuration. Any secret below may instead be given as
# NAME_FILE=/path/to/file (how Kubernetes mounts Secret Manager secrets).

NODE_ENV=development

# --------------------------------------------------------------- URLs
APP_URL=http://localhost:3001
FORM_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ---------------------------------------------------- Database (3 authorities)
# Migration/owner role: only `pnpm db:setup`, `pnpm db:migrate`, operations
# commands and DB test suites. Never available to a running web/worker in
# production.
MIGRATION_DATABASE_URL=postgresql://vercentlabs:CHANGE_ME@localhost:5433/vercentlabs_control
# Restricted web role (NOSUPERUSER, NOBYPASSRLS); created by db:setup.
DATABASE_URL=postgresql://vercent_app:CHANGE_ME@localhost:5433/vercentlabs_control
# Restricted worker role; optional locally (the worker then uses DATABASE_URL),
# required in production.
WORKER_DATABASE_URL=postgresql://vercent_worker:CHANGE_ME@localhost:5433/vercentlabs_control
ENFORCE_RESTRICTED_DB_ROLE=false
DATABASE_SSL=false
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_QUERY_TIMEOUT_MS=20000

# ---------------------------------------------------------- Sessions
SESSION_COOKIE_NAME=vercent_session
SESSION_IDLE_MINUTES=480
SESSION_ABSOLUTE_DAYS=30
MOBILE_ACCESS_TOKEN_MINUTES=30
MOBILE_REFRESH_TOKEN_DAYS=30
MOBILE_SESSION_IDLE_DAYS=14

# ------------------------------------------- Integration secret encryption
# Envelope encryption of OAuth tokens, MFA secrets and webhook/inbound signing
# secrets. Local/test: "local" with a 32-byte master key. Production:
# "gcp-kms" with a Cloud KMS key (SECRETS_KMS_KEY_NAME).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRETS_ENCRYPTION_PROVIDER=local
SECRETS_LOCAL_MASTER_KEY=
SECRETS_KMS_KEY_NAME=
# LEGACY, decrypt-only: the old single key. Keep it only until
# `pnpm secrets:migrate-legacy` reports 0 legacy records, then remove it.
INTEGRATION_TOKEN_ENCRYPTION_KEY=

# ------------------------------------------------------ File storage
# local (development), memory (tests), gcs (production; required there).
FILE_STORAGE_DRIVER=local
FILE_STORAGE_LOCAL_ROOT=
FILE_STORAGE_GCS_BUCKET=
FILE_STORAGE_GCS_PREFIX=
# Optional explicit Cloud Storage endpoint (private.googleapis.com; HTTPS in production).
FILE_STORAGE_GCS_API_ENDPOINT=
# Malware scanning: local (development) or required (production default).
ATTACHMENT_SCAN_MODE=local
ATTACHMENT_SCAN_URL=
ATTACHMENT_SCAN_TOKEN=

# ------------------------------------------------ Transactional email
# All four SMTP values together, or none. Production needs SMTP or
# AUTH_EMAIL_WEBHOOK_URL.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
AUTH_EMAIL_FROM=
AUTH_EMAIL_REPLY_TO=support@vercentlabs.com
AUTH_EMAIL_TIMEOUT_MS=10000
AUTH_EMAIL_WEBHOOK_URL=
AUTH_EMAIL_WEBHOOK_SECRET=
# Local/test only (refused in production): capture auth emails for E2E.
AUTH_EMAIL_CAPTURE_ENABLED=

# ------------------------------------------ SaaS billing (Razorpay)
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_WEBHOOK_SECRET_PREVIOUS=
RAZORPAY_REQUEST_TIMEOUT_MS=10000
BILLING_CHECKOUT_ENABLED=false
# Test stand-in only (refused in production).
RAZORPAY_API_BASE=
BILLING_SALES_CONTACT_URL=
# observe (development) | enforce (production: required).
BILLING_ENFORCEMENT_MODE=observe
BILLING_MAINTENANCE_ENABLED=true
BILLING_MAINTENANCE_INTERVAL_MS=15000
BILLING_MAINTENANCE_BATCH_SIZE=20

# ------------------------------------------------ OAuth connected accounts
# Redirect URI: {APP_URL}/api/settings/integrations/oauth/callback/<google|microsoft>
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
# Tests only (refused in production).
OAUTH_STANDIN_URL=

# ------------------------------------------------ CRM inbound integrations
CRM_CAPTURE_PROXY_SECRET=
CRM_INBOUND_EMAIL_SECRET=
CRM_PROVIDER_WEBHOOK_SECRET=
CRM_ACQUISITION_WEBHOOK_SECRET=
POS_SANDBOX_PAYMENT_WEBHOOK_SECRET=

# ---------------------------------------------------- Reverse proxy
# Production (Google Cloud load balancer): x-forwarded-for and -2.
TRUSTED_PROXY_IP_HEADER=
TRUSTED_PROXY_CLIENT_INDEX=

# ---------------------------------------------------------- Worker
WORKER_ENABLED=true
# Bounded concurrent organisation lanes; DATABASE_POOL_MAX >= WORKER_CONCURRENCY + 3.
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL_MS=5000
WORKER_LEASE_MS=120000
WORKER_BATCH_SIZE=10
WORKER_SCHEDULER_TICK_MS=300000
WORKER_WEBHOOK_TIMEOUT_MS=10000
WORKER_ALLOW_PRIVATE_WEBHOOK_TARGETS=false
WORKER_SHUTDOWN_DEADLINE_MS=60000
WORKER_HEALTH_PORT=8081

# ---------------------------------------------------- Observability
# Structured JSON logs carry these (Cloud Logging / Error Reporting).
DEPLOYMENT_ENVIRONMENT=local
RELEASE_SHA=

# ------------------------------------------- E2E / QA only (never deployed)
ERP_E2E_EMAIL=
ERP_E2E_PASSWORD=
ERP_E2E_RESTRICTED_EMAIL=
ERP_E2E_RESTRICTED_PASSWORD=
