  },
  "devDependencies": {
    "@vercentlabs/typescript-config": "workspace:*",
    "@vercentlabs/eslint-config": "workspace:*",
    "typescript": "5.7.3",
    "tsx": "4.19.2",
    "vitest": "2.1.8",
    "@types/node": "22.10.5",
    "@types/pg": "8.11.10"
  }
