# syntax=docker/dockerfile:1.7
# Public landing site (Next.js standalone). Same build rules as the web
# image: digest-pinned base, frozen lockfile, fixed non-root UID, no secrets.
ARG NODE_IMAGE=node:24-alpine@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1

FROM ${NODE_IMAGE} AS build
# NEXT_PUBLIC_* values are inlined into the bundle at build time, so the
# landing image is built per environment (deploy.yml passes both).
ARG NEXT_PUBLIC_SITE_URL
ARG NEXT_PUBLIC_APP_URL
ENV CI=1 NEXT_TELEMETRY_DISABLED=1 NEXT_PUBLIC_SITE_URL=${NEXT_PUBLIC_SITE_URL} NEXT_PUBLIC_APP_URL=${NEXT_PUBLIC_APP_URL}
RUN npm install --global --no-fund --no-audit pnpm@11.21.0
WORKDIR /app
# pnpm-workspace.yaml declares patchedDependencies: the patch files must be
# present before install (COPY . . includes patches/).
COPY . .
RUN --mount=type=cache,id=pnpm-store,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile --filter "@vercentlabs/landing..."
RUN pnpm --filter @vercentlabs/landing build

FROM ${NODE_IMAGE} AS runtime
ARG GIT_SHA=unknown
LABEL org.opencontainers.image.title="vercentlabs-erp-landing" \
      org.opencontainers.image.description="Vercentlabs public landing site" \
      org.opencontainers.image.vendor="Vercentlabs" \
      org.opencontainers.image.revision="${GIT_SHA}"
ENV NODE_ENV=production PORT=3000 HOSTNAME=0.0.0.0 NEXT_TELEMETRY_DISABLED=1
WORKDIR /app
RUN addgroup -S -g 10001 vercentlabs && adduser -S -D -H -u 10001 -G vercentlabs vercentlabs
COPY --from=build --chown=10001:10001 /app/apps/landing/.next/standalone ./
COPY --from=build --chown=10001:10001 /app/apps/landing/.next/static ./apps/landing/.next/static
COPY --from=build --chown=10001:10001 /app/apps/landing/public ./apps/landing/public
USER 10001:10001
EXPOSE 3000
CMD ["node", "apps/landing/server.js"]
