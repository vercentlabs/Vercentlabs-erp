# syntax=docker/dockerfile:1.7
# ERP database migration Job (infrastructure/kubernetes/jobs/migration.yaml). The worker's production install plus database/migrations;
# it runs services/worker/bin/migrate.mjs once and exits. Digest-pinned base, frozen lockfile, fixed non-root UID. It is the only image
# that receives MIGRATION_DATABASE_URL (the owner role), at run time from Secret Manager — never baked in.
ARG NODE_IMAGE=node:24-alpine@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1

FROM ${NODE_IMAGE} AS build
ENV CI=1
RUN npm install --global --no-fund --no-audit pnpm@11.21.0
WORKDIR /app
COPY . .
RUN --mount=type=cache,id=pnpm-store,target=/root/.local/share/pnpm/store \
    pnpm install --prod --frozen-lockfile --filter "@vercentlabs/worker..."

FROM ${NODE_IMAGE} AS runtime
ARG GIT_SHA=unknown
LABEL org.opencontainers.image.title="vercentlabs-erp-migration" \
      org.opencontainers.image.description="Vercentlabs ERP database migrations" \
      org.opencontainers.image.vendor="Vercentlabs" \
      org.opencontainers.image.revision="${GIT_SHA}"
ENV NODE_ENV=production RELEASE_SHA=${GIT_SHA} MIGRATIONS_DIR=/app/database/migrations
RUN addgroup -S -g 10001 vercentlabs && adduser -S -D -H -u 10001 -G vercentlabs vercentlabs
WORKDIR /app
COPY --from=build --chown=10001:10001 /app/package.json ./package.json
COPY --from=build --chown=10001:10001 /app/node_modules ./node_modules
COPY --from=build --chown=10001:10001 /app/.pnpm ./.pnpm
COPY --from=build --chown=10001:10001 /app/packages ./packages
COPY --from=build --chown=10001:10001 /app/services/api ./services/api
COPY --from=build --chown=10001:10001 /app/services/worker ./services/worker
COPY --from=build --chown=10001:10001 /app/database/migrations ./database/migrations
WORKDIR /app/services/worker
USER 10001:10001
CMD ["node", "bin/migrate.mjs"]
