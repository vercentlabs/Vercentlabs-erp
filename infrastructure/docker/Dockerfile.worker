# syntax=docker/dockerfile:1.7
# ERP background worker. A production-only install of the worker and the
# workspace packages it depends on (@vercentlabs/api, config, database,
# observability, ...). Digest-pinned base, frozen lockfile, fixed non-root
# UID, no secrets or migration credentials.
ARG NODE_IMAGE=node:24-alpine@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1

FROM ${NODE_IMAGE} AS build
ENV CI=1
RUN npm install --global --no-fund --no-audit pnpm@11.21.0
WORKDIR /app
COPY . .
RUN --mount=type=cache,id=pnpm-store,target=/root/.local/share/pnpm/store \
    pnpm install --prod --frozen-lockfile --filter "@vercentlabs/worker..."

FROM ${NODE_IMAGE} AS runtime
ARG GIT_SHA=unknown
LABEL org.opencontainers.image.title="vercentlabs-erp-worker" \
      org.opencontainers.image.description="Vercentlabs ERP background worker" \
      org.opencontainers.image.vendor="Vercentlabs" \
      org.opencontainers.image.revision="${GIT_SHA}"
ENV NODE_ENV=production RELEASE_SHA=${GIT_SHA}
RUN addgroup -S -g 10001 vercentlabs && adduser -S -D -H -u 10001 -G vercentlabs vercentlabs
WORKDIR /app
COPY --from=build --chown=10001:10001 /app/package.json ./package.json
COPY --from=build --chown=10001:10001 /app/node_modules ./node_modules
COPY --from=build --chown=10001:10001 /app/.pnpm ./.pnpm
COPY --from=build --chown=10001:10001 /app/packages ./packages
COPY --from=build --chown=10001:10001 /app/services/api ./services/api
COPY --from=build --chown=10001:10001 /app/services/worker ./services/worker
WORKDIR /app/services/worker
USER 10001:10001
EXPOSE 8081
CMD ["node", "bin/start.mjs"]
