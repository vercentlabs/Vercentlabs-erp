# Production runtime environment of the WEB pod, exactly as Kubernetes
# provides it (never edited by hand; change the ConfigMap template or the
# production DEPLOY_VALUES_JSON and redeploy). <...> = from terraform output or
# the deploy values. Secrets are files mounted from Secret Manager; their
# plain NAME is never set.
NODE_ENV=production
DEPLOYMENT_ENVIRONMENT=production
RELEASE_SHA=<commit sha, set by the deploy workflow>
APP_URL=https://<erp host>
FORM_ALLOWED_ORIGINS=https://<erp host>,https://<landing host>

# Database: restricted web role through the Cloud SQL Auth Proxy sidecar.
DATABASE_URL_FILE=/var/run/secrets/vercentlabs/DATABASE_URL   # postgresql://vercent_web:***@127.0.0.1:5432/vercentlabs
ENFORCE_RESTRICTED_DB_ROLE=true
DATABASE_SSL=false            # loopback to the proxy; proxy -> Cloud SQL is mTLS
DATABASE_POOL_MAX=10          # within the connection budget (terraform/README.md)
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_QUERY_TIMEOUT_MS=20000
# MIGRATION_DATABASE_URL and WORKER_DATABASE_URL are refused in the web.

TRUSTED_PROXY_IP_HEADER=x-forwarded-for
TRUSTED_PROXY_CLIENT_INDEX=-2
SESSION_COOKIE_NAME=vercent_session
SESSION_IDLE_MINUTES=480
SESSION_ABSOLUTE_DAYS=30

BILLING_ENFORCEMENT_MODE=enforce
BILLING_CHECKOUT_ENABLED=true
RAZORPAY_MODE=live
RAZORPAY_KEY_ID=rzp_live_<id>
RAZORPAY_KEY_SECRET_FILE=/var/run/secrets/vercentlabs/RAZORPAY_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET_FILE=/var/run/secrets/vercentlabs/RAZORPAY_WEBHOOK_SECRET

FILE_STORAGE_DRIVER=gcs
FILE_STORAGE_GCS_BUCKET=<terraform output files_bucket>
ATTACHMENT_SCAN_MODE=required
ATTACHMENT_SCAN_URL=https://<scanner>
ATTACHMENT_SCAN_TOKEN_FILE=/var/run/secrets/vercentlabs/ATTACHMENT_SCAN_TOKEN

SECRETS_ENCRYPTION_PROVIDER=gcp-kms
SECRETS_KMS_KEY_NAME=<terraform output secrets_kms_key_name>

SMTP_HOST=<smtp host>
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<smtp user>
SMTP_PASSWORD_FILE=/var/run/secrets/vercentlabs/SMTP_PASSWORD
AUTH_EMAIL_FROM=<from address>
AUTH_EMAIL_REPLY_TO=<reply-to>

# Optional components (infrastructure/kubernetes/components/*) add, e.g.:
# GOOGLE_OAUTH_CLIENT_ID=<id> and GOOGLE_OAUTH_CLIENT_SECRET_FILE=...
# INTEGRATION_TOKEN_ENCRYPTION_KEY_FILE=...   (legacy, decrypt-only, temporary)

# Refused in production: OAUTH_STANDIN_URL, RAZORPAY_API_BASE,
# AUTH_EMAIL_CAPTURE_ENABLED, FILE_STORAGE_DRIVER=local|memory,
# SECRETS_ENCRYPTION_PROVIDER=local, BILLING_ENFORCEMENT_MODE=observe,
# WORKER_ALLOW_PRIVATE_WEBHOOK_TARGETS=true.
