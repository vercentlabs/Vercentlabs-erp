# Staging runtime environment, as the web pod receives it. Nothing here is set
# by hand: non-secret values come from the vercentlabs-web ConfigMap
# (infrastructure/kubernetes/base/configmap.yaml, rendered from the staging
# DEPLOY_VALUES_JSON); secrets are Secret Manager files (NAME_FILE). The worker
# receives the vercentlabs-worker ConfigMap (WORKER_* settings,
# WORKER_DATABASE_URL_FILE). Same shape as production; see
# production.env.example for the full list.
NODE_ENV=production
DEPLOYMENT_ENVIRONMENT=staging
APP_URL=https://erp.staging.example.com
FORM_ALLOWED_ORIGINS=https://erp.staging.example.com,https://staging.example.com
BILLING_ENFORCEMENT_MODE=enforce
RAZORPAY_MODE=test
BILLING_CHECKOUT_ENABLED=false
FILE_STORAGE_DRIVER=gcs
FILE_STORAGE_GCS_BUCKET=<terraform output files_bucket>
SECRETS_ENCRYPTION_PROVIDER=gcp-kms
SECRETS_KMS_KEY_NAME=<terraform output secrets_kms_key_name>
DATABASE_URL_FILE=/var/run/secrets/vercentlabs/DATABASE_URL
