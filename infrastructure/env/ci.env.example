# CI (GitHub Actions, .github/workflows/erp-ci.yml + infrastructure-ci.yml).
# Throwaway PostgreSQL 16 service; no cloud, payment, OAuth or mail
# credentials — providers are local stand-ins and mail is captured offline
# (tests/support/offline-mail.mjs). Pull requests never receive secrets.
NODE_ENV=test
MIGRATION_DATABASE_URL=postgresql://vercentlabs:ci_owner_password@localhost:5433/vercentlabs_control
DATABASE_URL=postgresql://vercent_app:ci_app_password@localhost:5433/vercentlabs_control
WORKER_DATABASE_URL=postgresql://vercent_worker:ci_worker_password@localhost:5433/vercentlabs_control
DATABASE_SSL=false
CRM_ACCESS_DB_REQUIRED=1
SECRETS_ENCRYPTION_PROVIDER=local
# Generated per run by the suites that need it; never a shared value.
SECRETS_LOCAL_MASTER_KEY=
FILE_STORAGE_DRIVER=memory
BILLING_ENFORCEMENT_MODE=enforce
RAZORPAY_MODE=test
# Optional, secret-gated, never on pull requests: real SMTP smoke.
LIVE_SMTP_SMOKE=
