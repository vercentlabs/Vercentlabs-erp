# Copy to deploy.env (git-ignored) and fill in. No passwords here: deploy.sh asks for the two it cannot generate (the Hostinger
# mailbox and the Google OAuth secret) once, and keeps every secret in Google Secret Manager.

# Google Cloud project ID (not the number), e.g. vercentlabs-erp-prod. gcloud projects list shows it.
PROJECT_ID=

# Mumbai: closest to Indian users, and data stays in India.
REGION=asia-south1

SITE_DOMAIN=vercentlabs.com
APP_DOMAIN=app.vercentlabs.com

# Cloud SQL size. db-custom-1-3840 = 1 vCPU, 3.75 GB (about ₹4,500/month). db-g1-small is cheaper for a pilot (about ₹2,300).
SQL_TIER=db-custom-1-3840

# Sign-in codes and notifications go out from a Hostinger mailbox (hPanel › Emails › create noreply@vercentlabs.com first).
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@vercentlabs.com
AUTH_EMAIL_FROM=Vercentlabs <noreply@vercentlabs.com>
AUTH_EMAIL_REPLY_TO=support@vercentlabs.com

# Google sign-in, account linking and calendar sync (the same OAuth client as local; add the production redirect URIs to it).
GOOGLE_OAUTH_CLIENT_ID=

# Card checkout via Razorpay stays off until live keys are added (companies get their trial; plans are activated by you).
BILLING_CHECKOUT_ENABLED=false
