# Copy to .env and adjust for local development.
# No real secrets belong in this file or in git.

NODE_ENV=development

# --- apps/web ---
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1

# --- apps/api ---
API_PORT=3001
API_CORS_ORIGINS=http://localhost:3000
CORRELATION_HEADER_NAME=x-correlation-id

# --- apps/worker ---
WORKER_HEALTH_PORT=3002

# --- PostgreSQL (shared by api and worker) ---
DATABASE_URL=postgres://vercentlabs:vercentlabs_dev_password@localhost:5432/vercentlabs_erp
PLATFORM_DATABASE_SCHEMA=platform
TENANT_DATABASE_SCHEMA=tenant

# --- Redis (shared by api and worker) ---
REDIS_URL=redis://localhost:6379

# --- Integration tests (tests/integration, packages/database test helper) ---
# Must contain "test" in the database name; @vercentlabs/database/testing
# refuses to run against anything else.
TEST_DATABASE_URL=postgres://vercentlabs:vercentlabs_dev_password@localhost:5432/vercentlabs_erp_test

# --- Observability ---
LOG_LEVEL=info
OTEL_ENABLED=false

# --- Docker Compose local infrastructure ---
POSTGRES_USER=vercentlabs
POSTGRES_PASSWORD=vercentlabs_dev_password
POSTGRES_DB=vercentlabs_erp
POSTGRES_PORT=5432
REDIS_PORT=6379
