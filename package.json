{
  "name": "vercentlabs-erp",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.5.1",
  "scripts": {
    "start": "node server.js",
    "build": "npx --yes pnpm@11.21.0 install --frozen-lockfile && npx --yes pnpm@11.21.0 --filter @vercentlabs/landing build",
    "dev": "npx --yes pnpm@11.21.0 --parallel --filter @vercentlabs/landing --filter @vercentlabs/web dev",
    "dev:mobile": "npx --yes pnpm@11.21.0 --filter @vercentlabs/mobile dev",
    "dev:landing": "npx --yes pnpm@11.21.0 --filter @vercentlabs/landing dev",
    "build:landing": "npx --yes pnpm@11.21.0 --filter @vercentlabs/landing build",
    "start:landing": "npx --yes pnpm@11.21.0 --filter @vercentlabs/landing start",
    "lint:landing": "npx --yes pnpm@11.21.0 --filter @vercentlabs/landing lint",
    "typecheck:landing": "npx --yes pnpm@11.21.0 --filter @vercentlabs/landing typecheck",
    "format:landing": "npx --yes pnpm@11.21.0 --filter @vercentlabs/landing format",
    "content:cannibalization": "npx --yes pnpm@11.21.0 --filter @vercentlabs/landing-content content:cannibalization",
    "content:stale": "npx --yes pnpm@11.21.0 --filter @vercentlabs/landing-content content:stale",
    "dev:web": "npx --yes pnpm@11.21.0 --filter @vercentlabs/web dev",
    "build:web": "npx --yes pnpm@11.21.0 --filter @vercentlabs/web build",
    "build:erp": "npx --yes pnpm@11.21.0 build:web",
    "build:all": "npx --yes pnpm@11.21.0 build:landing && npx --yes pnpm@11.21.0 build:web",
    "lint:web": "npx --yes pnpm@11.21.0 --filter @vercentlabs/web lint",
    "typecheck:web": "npx --yes pnpm@11.21.0 --filter @vercentlabs/web typecheck",
    "dev:worker": "npx --yes pnpm@11.21.0 --filter @vercentlabs/worker dev",
    "start:worker": "npx --yes pnpm@11.21.0 --filter @vercentlabs/worker start",
    "infra:up": "docker compose -f infrastructure/docker/compose.local.yml up -d --wait",
    "infra:down": "docker compose -f infrastructure/docker/compose.local.yml down",
    "infra:logs": "docker compose -f infrastructure/docker/compose.local.yml logs -f",
    "format:web": "npx --yes pnpm@11.21.0 --filter @vercentlabs/web format",
    "lint:mobile": "npx --yes pnpm@11.21.0 --filter @vercentlabs/mobile lint",
    "typecheck:mobile": "npx --yes pnpm@11.21.0 --filter @vercentlabs/mobile typecheck",
    "doctor:mobile": "npx --yes pnpm@11.21.0 --filter @vercentlabs/mobile doctor",
    "export:mobile": "npx --yes pnpm@11.21.0 --filter @vercentlabs/mobile export",
    "audit:dependencies": "npx --yes pnpm@11.21.0 audit --audit-level high",
    "format:check": "npx --yes pnpm@11.21.0 --filter @vercentlabs/web format:check && npx --yes pnpm@11.21.0 --filter @vercentlabs/web exec prettier --check ../../package.json",
    "test:platform": "node scripts/database/tests/platform.smoke.mjs",
    "test:rbac": "node scripts/database/tests/rbac.smoke.mjs",
    "test:finance-foundation": "node scripts/database/tests/finance-foundation.smoke.mjs",
    "test:finance-journals": "node scripts/database/tests/finance-journals.smoke.mjs",
    "test:finance-postings": "node scripts/database/tests/finance-postings.smoke.mjs",
    "test:finance-receivables": "node scripts/database/tests/finance-receivables.smoke.mjs",
    "test:finance-payables": "node scripts/database/tests/finance-payables.smoke.mjs",
    "test:finance-banking": "node scripts/database/tests/finance-banking.smoke.mjs",
    "test:finance-expenses": "node scripts/database/tests/finance-expenses.smoke.mjs",
    "test:finance-statements": "node scripts/database/tests/finance-statements.smoke.mjs",
    "test:finance-close": "node scripts/database/tests/finance-close.smoke.mjs",
    "test:finance-home": "node scripts/database/tests/finance-home.smoke.mjs",
    "test:quality-incoming": "node scripts/database/tests/quality-incoming.smoke.mjs",
    "test:quality-inprocess": "node scripts/database/tests/quality-inprocess.smoke.mjs",
    "test:quality-final": "node scripts/database/tests/quality-final.smoke.mjs",
    "test:quality-dispatch": "node scripts/database/tests/quality-dispatch.smoke.mjs",
    "test:quality-nonconformance": "node scripts/database/tests/quality-nonconformance.smoke.mjs",
    "test:support-desk": "node scripts/database/tests/support-desk.smoke.mjs",
    "test:payroll-statutory": "node scripts/database/tests/payroll-statutory.smoke.mjs",
    "verify:fast": "npx --yes pnpm@11.21.0 typecheck:web && npx --yes pnpm@11.21.0 lint:web",
    "verify:routes": "npx --yes pnpm@11.21.0 --filter @vercentlabs/web verify:routes",
    "verify:web": "npx --yes pnpm@11.21.0 verify:fast && npx --yes pnpm@11.21.0 verify:routes && npx --yes pnpm@11.21.0 build:web",
    "verify:mobile": "npx --yes pnpm@11.21.0 typecheck:mobile && npx --yes pnpm@11.21.0 lint:mobile",
    "verify": "npx --yes pnpm@11.21.0 verify:fast && npx --yes pnpm@11.21.0 verify:routes && npx --yes pnpm@11.21.0 verify:mobile",
    "verify:erp": "npx --yes pnpm@11.21.0 verify",
    "release:verify": "npx --yes pnpm@11.21.0 verify && npx --yes pnpm@11.21.0 build:web && npx --yes pnpm@11.21.0 lint:landing && npx --yes pnpm@11.21.0 typecheck:landing && npx --yes pnpm@11.21.0 build:landing",
    "release:gate": "npx --yes pnpm@11.21.0 format:check && npx --yes pnpm@11.21.0 audit:dependencies && npx --yes pnpm@11.21.0 release:verify",
    "verify:release": "npx --yes pnpm@11.21.0 release:gate",
    "verify:platform": "npx --yes pnpm@11.21.0 typecheck:web && npx --yes pnpm@11.21.0 lint:web && npx --yes pnpm@11.21.0 build:web",
    "deadcode:check": "npx --yes pnpm@11.21.0 exec knip"
  },
  "engines": {
    "node": ">=24 <25",
    "pnpm": "11.21.0"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "knip": "6.37.0"
  }
}
