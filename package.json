{
  "name": "vercentlabs-erp",
  "version": "0.1.0",
  "private": true,
  "description": "Vercentlabs ERP V2 monorepo - engineering and shared-platform foundation",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "pnpm": "11.21.0"
  },
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run build && turbo run test && pnpm test:contracts && pnpm test:security",
    "test:contracts": "turbo run build && vitest run --config tests/contracts/vitest.config.ts",
    "test:security": "turbo run build && vitest run --config tests/security/vitest.config.ts",
    "test:integration": "turbo run build && turbo run test:integration && vitest run --config tests/integration/vitest.config.ts",
    "test:e2e": "playwright test --config tests/journeys/playwright.config.ts",
    "test:architecture": "turbo run build && vitest run --config tests/architecture/vitest.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "register:validate": "tsx scripts/validate-register.ts",
    "db:migrate": "tsx packages/database/src/migrate.ts",
    "db:migrate:platform": "tsx packages/database/src/migrate.ts --scope=platform",
    "db:migrate:tenant": "tsx packages/database/src/migrate.ts --scope=tenant",
    "infra:up": "docker compose -f infrastructure/docker-compose.yml up -d",
    "infra:down": "docker compose -f infrastructure/docker-compose.yml down",
    "clean": "node scripts/clean.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "devDependencies": {
    "@vercentlabs/testing": "workspace:*",
    "@vercentlabs/contracts": "workspace:*",
    "@vercentlabs/configuration": "workspace:*",
    "@vercentlabs/observability": "workspace:*",
    "@vercentlabs/database": "workspace:*",
    "@vercentlabs/platform-tenancy": "workspace:*",
    "@vercentlabs/platform-organization": "workspace:*",
    "@vercentlabs/platform-audit": "workspace:*",
    "@vercentlabs/platform-outbox": "workspace:*",
    "@vercentlabs/platform-identity": "workspace:*",
    "otpauth": "9.5.2",
    "drizzle-orm": "0.38.3",
    "ioredis": "5.4.2",
    "pg": "8.13.1",
    "@types/pg": "8.11.10",
    "turbo": "2.3.3",
    "typescript": "5.7.3",
    "eslint": "9.17.0",
    "@eslint/js": "9.17.0",
    "typescript-eslint": "8.19.0",
    "eslint-config-prettier": "9.1.0",
    "prettier": "3.4.2",
    "vitest": "2.1.8",
    "@vitest/coverage-v8": "2.1.8",
    "@playwright/test": "1.49.1",
    "@axe-core/playwright": "4.10.1",
    "tsx": "4.19.2",
    "zod": "3.24.1",
    "js-yaml": "4.1.0",
    "@types/js-yaml": "4.0.9",
    "@types/node": "22.10.5"
  }
}
