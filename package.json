{
  "name": "vercentlabs-erp",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.13.0",
  "scripts": {
    "start": "node server.js",
    "dev": "corepack pnpm --parallel --filter @vercent/landing --filter @vercent/web dev",
    "dev:landing": "corepack pnpm --filter @vercent/landing dev",
    "build:landing": "corepack pnpm --filter @vercent/landing build",
    "lint:landing": "corepack pnpm --filter @vercent/landing lint",
    "typecheck:landing": "corepack pnpm --filter @vercent/landing typecheck",
    "format:landing": "corepack pnpm --filter @vercent/landing format",
    "dev:web": "corepack pnpm --filter @vercent/web dev",
    "build:web": "corepack pnpm --filter @vercent/web build",
    "lint:web": "corepack pnpm --filter @vercent/web lint",
    "typecheck:web": "corepack pnpm --filter @vercent/web typecheck",
    "infra:up": "docker compose -f infrastructure/docker/compose.local.yml up -d",
    "infra:down": "docker compose -f infrastructure/docker/compose.local.yml down",
    "infra:logs": "docker compose -f infrastructure/docker/compose.local.yml logs -f",
    "db:migrate:control": "corepack pnpm --filter @vercent/web db:migrate",
    "test:web": "corepack pnpm --filter @vercent/web test",
    "format:web": "corepack pnpm --filter @vercent/web format",
    "verify:web": "corepack pnpm --filter @vercent/web verify:foundation",
    "verify:database": "corepack pnpm --filter @vercent/web verify:database",
    "db:cleanup:auth": "corepack pnpm --filter @vercent/web db:cleanup-auth",
    "db:verify:control": "corepack pnpm --filter @vercent/web verify:database",
    "email:verify": "corepack pnpm --filter @vercent/web email:verify",
    "verify:platform-foundation": "node scripts/validation/verify-platform-foundation.mjs",
    "verify:web-experience": "corepack pnpm --filter @vercent/web verify:experience",
    "db:migrate:tenant": "corepack pnpm --filter @vercent/web db:migrate:tenant",
    "db:verify:tenant": "corepack pnpm --filter @vercent/web verify:tenant-database",
    "verify:business-data": "corepack pnpm --filter @vercent/web verify:business-data && corepack pnpm --filter @vercent/api test && corepack pnpm --filter @vercent/shared-sdk test",
    "verify:crm": "corepack pnpm --filter @vercent/web verify:crm && corepack pnpm --filter @vercent/api test && corepack pnpm --filter @vercent/shared-sdk test",
    "db:verify:crm": "corepack pnpm --filter @vercent/web verify:crm-database",
    "crm:jobs": "corepack pnpm --filter @vercent/web crm:jobs",
    "verify:billing": "corepack pnpm --filter @vercent/web verify:billing && corepack pnpm --filter @vercent/api test && corepack pnpm --filter @vercent/shared-sdk test && node scripts/validation/verify-commercial-readiness.mjs",
    "db:verify:billing": "corepack pnpm --filter @vercent/web verify:billing-database",
    "billing:sync-plans": "corepack pnpm --filter @vercent/web billing:sync-plans",
    "billing:reconcile": "corepack pnpm --filter @vercent/web billing:reconcile",
    "verify:commercial-readiness": "node scripts/validation/verify-commercial-readiness.mjs",
    "db:provision:runtime-role": "corepack pnpm --filter @vercent/web exec node scripts/provision-runtime-role.mjs",
    "crm:outbox": "corepack pnpm --filter @vercent/web crm:outbox",
    "test:landing": "corepack pnpm --filter @vercent/landing test",
    "test:api": "corepack pnpm --filter @vercent/api test",
    "test:sdk": "corepack pnpm --filter @vercent/shared-sdk test",
    "test:all": "corepack pnpm test:landing && corepack pnpm test:web && corepack pnpm test:api && corepack pnpm test:sdk",
    "verify:release": "node scripts/validation/verify-crm-release.mjs && pnpm verify:platform-foundation && pnpm verify:business-data && pnpm verify:crm && pnpm verify:billing && pnpm verify:commercial-readiness",
    "validate:production-env:web": "node scripts/deployment/validate-production-env.mjs web",
    "validate:production-env:landing": "node scripts/deployment/validate-production-env.mjs landing",
    "validate:production-env:migration": "node scripts/deployment/validate-production-env.mjs migration",
    "smoke:deployment": "node scripts/deployment/smoke-deployment.mjs",
    "db:backup": "bash scripts/database/backup-postgres.sh",
    "db:restore": "bash scripts/database/restore-postgres.sh",
    "release:gate": "pnpm test:all && pnpm verify:release && pnpm lint:landing && pnpm typecheck:landing && pnpm build:landing && pnpm lint:web && pnpm typecheck:web && pnpm build:web"
  },
  "engines": {
    "node": ">=24 <25",
    "pnpm": "11.13.0"
  }
}
