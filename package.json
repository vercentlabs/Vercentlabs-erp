{
  "name": "vercentlabs-erp",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.5.1",
  "scripts": {
    "start": "node server.js",
    "build": "npx --yes pnpm@11.21.0 install --frozen-lockfile && npx --yes pnpm@11.21.0 --filter @vercentlabs/landing build",
    "predev": "node scripts/dev/free-ports.mjs",
    "dev": "pnpm --parallel --filter @vercentlabs/landing --filter @vercentlabs/web dev",
    "dev:mobile": "pnpm --filter @vercentlabs/mobile dev",
    "dev:landing": "pnpm --filter @vercentlabs/landing dev",
    "build:landing": "pnpm --filter @vercentlabs/landing build",
    "start:landing": "pnpm --filter @vercentlabs/landing start",
    "lint:landing": "pnpm --filter @vercentlabs/landing lint",
    "typecheck:landing": "pnpm --filter @vercentlabs/landing typecheck",
    "format:landing": "pnpm --filter @vercentlabs/landing format",
    "content:validate": "pnpm --filter @vercentlabs/landing-content content:validate",
    "content:links": "pnpm --filter @vercentlabs/landing-content content:links",
    "content:freshness": "pnpm --filter @vercentlabs/landing-content content:freshness",
    "content:cannibalization": "pnpm --filter @vercentlabs/landing-content content:cannibalization",
    "content:stale": "pnpm --filter @vercentlabs/landing-content content:stale",
    "dev:web": "pnpm --filter @vercentlabs/web dev",
    "build:web": "pnpm --filter @vercentlabs/web build",
    "build:erp": "pnpm build:web",
    "build:all": "pnpm build:landing && pnpm build:web",
    "lint:web": "pnpm --filter @vercentlabs/web lint",
    "typecheck:web": "pnpm --filter @vercentlabs/web typecheck",
    "dev:worker": "pnpm --filter @vercentlabs/worker dev",
    "start:worker": "pnpm --filter @vercentlabs/worker start",
    "test:worker": "pnpm --filter @vercentlabs/worker test",
    "verify:worker": "pnpm test:worker && node scripts/validation/verify-worker-structure.mjs",
    "infra:up": "docker compose -f infrastructure/docker/compose.local.yml up -d --wait",
    "infra:down": "docker compose -f infrastructure/docker/compose.local.yml down",
    "infra:logs": "docker compose -f infrastructure/docker/compose.local.yml logs -f",
    "test:web": "pnpm --filter @vercentlabs/web test",
    "test:e2e:erp": "pnpm --filter @vercentlabs/web test:e2e:erp",
    "test:e2e:crm": "pnpm --filter @vercentlabs/web test:e2e:crm",
    "format:web": "pnpm --filter @vercentlabs/web format",
    "test:landing": "pnpm --filter @vercentlabs/landing test",
    "test:landing:e2e": "pnpm --filter @vercentlabs/landing test:e2e",
    "test:landing:browser": "pnpm --filter @vercentlabs/landing test:browser",
    "test:api": "pnpm --filter @vercentlabs/api test",
    "test:sdk": "pnpm --filter @vercentlabs/shared-sdk test",
    "test:mobile": "pnpm --filter @vercentlabs/mobile test",
    "lint:mobile": "pnpm --filter @vercentlabs/mobile lint",
    "typecheck:mobile": "pnpm --filter @vercentlabs/mobile typecheck",
    "doctor:mobile": "pnpm --filter @vercentlabs/mobile doctor",
    "export:mobile": "pnpm --filter @vercentlabs/mobile export",
    "test:packages": "pnpm --filter @vercentlabs/config --filter @vercentlabs/document-engine --filter @vercentlabs/landing-content --filter @vercentlabs/localization --filter @vercentlabs/observability --filter @vercentlabs/reporting-engine --filter @vercentlabs/design-tokens --filter @vercentlabs/test-utils --filter @vercentlabs/workflows --filter @vercentlabs/permissions test",
    "test:integration": "node --test tests/integration/*.test.mjs",
    "test:security": "node --test tests/security/*.test.mjs",
    "test:enterprise-rbac": "node --test services/api/tests/enterprise-rbac.test.mjs",
    "test:all": "pnpm test:landing && pnpm test:web && pnpm test:api && pnpm test:worker && pnpm test:sdk && pnpm test:mobile && pnpm test:packages && pnpm test:integration && pnpm test:security",
    "audit:dependencies": "pnpm audit --audit-level high",
    "format:check": "pnpm --filter @vercentlabs/web format:check && pnpm --filter @vercentlabs/web exec prettier --check ../../package.json",
    "verify:fast": "pnpm typecheck:web && pnpm lint:web && pnpm test:web && pnpm test:api",
    "verify:routes": "pnpm --filter @vercentlabs/web verify:routes",
    "verify:route-security": "node scripts/qa/validate-route-security.mjs",
    "verify:web": "pnpm verify:experience && pnpm verify:fast && pnpm verify:routes && pnpm build:web",
    "verify:mobile": "pnpm typecheck:mobile && pnpm lint:mobile",
    "verify:db": "node scripts/validation/verify-db-structure.mjs",
    "verify:no-legacy-frontend": "node scripts/validation/verify-no-legacy-frontend.mjs",
    "export:source": "node scripts/export/export-source.mjs",
    "verify:source-export": "node scripts/export/verify-source-export.mjs",
    "verify": "pnpm verify:toolchain && pnpm verify:t01 && pnpm verify:experience && pnpm verify:architecture && pnpm verify:fast && pnpm verify:routes && pnpm verify:route-security && pnpm verify:mobile && pnpm verify:db && pnpm verify:worker && pnpm test:sdk && pnpm test:packages && pnpm test:integration && pnpm test:security && pnpm test:enterprise-rbac",
    "verify:erp": "pnpm verify",
    "release:verify": "pnpm verify && pnpm build:web && pnpm lint:landing && pnpm typecheck:landing && pnpm build:landing && pnpm test:landing && pnpm test:landing:e2e",
    "release:gate": "pnpm format:check && pnpm audit:dependencies && pnpm release:verify",
    "verify:release": "pnpm release:gate",
    "verify:architecture": "node scripts/validation/verify-architecture.mjs && node scripts/validation/verify-doc-links.mjs",
    "ux:generate-traceability": "node scripts/ux/generate-ux-traceability.mjs",
    "verify:ux-coverage": "node scripts/ux/verify-ux-coverage.mjs",
    "db:migrate:platform": "node scripts/database/migrate.mjs platform",
    "db:migrate:tenant": "node scripts/database/migrate.mjs tenant",
    "db:migrate": "pnpm db:migrate:platform && pnpm db:migrate:tenant",
    "db:baseline:platform": "node scripts/database/migrate.mjs platform --baseline-existing",
    "db:baseline:tenant": "node scripts/database/migrate.mjs tenant --baseline-existing",
    "db:baseline": "pnpm db:baseline:platform && pnpm db:baseline:tenant",
    "db:provision:runtime-role": "node scripts/database/provision-runtime-role.mjs",
    "db:setup": "pnpm db:migrate && pnpm db:provision:runtime-role",
    "test:platform-packages": "pnpm --filter @vercentlabs/config --filter @vercentlabs/document-engine --filter @vercentlabs/localization --filter @vercentlabs/observability --filter @vercentlabs/reporting-engine --filter @vercentlabs/design-tokens --filter @vercentlabs/test-utils --filter @vercentlabs/workflows test",
    "verify:platform-foundation": "node scripts/validation/verify-platform-foundation.mjs",
    "verify:platform": "pnpm verify:platform-foundation && pnpm verify:experience && pnpm verify:architecture && pnpm verify:db && pnpm verify:worker && pnpm test:platform-packages && pnpm test:api && pnpm test:sdk && pnpm test:integration && pnpm test:security && pnpm test:enterprise-rbac && pnpm typecheck:web && pnpm lint:web && pnpm build:web",
    "verify:docs": "node scripts/validation/verify-doc-links.mjs",
    "verify:toolchain": "node scripts/validation/verify-toolchain.mjs",
    "test:toolchain": "node --test scripts/validation/verify-toolchain.test.mjs",
    "verify:t01": "node scripts/validation/verify-t01-shared-platform.mjs && node --test services/api/tests/t01-shared-platform-imports.test.mjs",
    "verify:experience": "node scripts/validation/verify-experience.mjs && node --test scripts/validation/verify-experience.test.mjs",
    "verify:crm:backend": "node scripts/validation/verify-architecture.mjs && node scripts/validation/verify-db-structure.mjs && node scripts/validation/verify-crm-module-contracts.mjs && node --test services/api/tests/crm*.test.mjs",
    "verify:crm": "pnpm verify:crm:backend && pnpm test:api",
    "design:generate": "node scripts/design/generate-theme.mjs && node scripts/design/generate-tailwind-theme.mjs",
    "design:check": "node scripts/design/generate-theme.mjs --check && node scripts/design/generate-tailwind-theme.mjs --check"
  },
  "engines": {
    "node": ">=24 <25",
    "pnpm": "11.21.0"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "pg": "^8.16.3"
  }
}
